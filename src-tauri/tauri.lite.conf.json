{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legato Lite",
  "identifier": "app.legato.lite",
  "build": {
    "beforeDevCommand": "pnpm vite --mode lite",
    "beforeBuildCommand": "pnpm vite build --mode lite"
  },
  "bundle": {
    "fileAssociations": null,
    "windows": { "nsis": { "installerHooks": "./windows/hooks-lite.nsh" } }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/legato-app/legato/releases/latest/download/latest-lite.json"]
    }
  }
}
